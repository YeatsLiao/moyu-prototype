.page { padding: 24rpx 28rpx 40rpx; }

.hud { display: flex; gap: 16rpx; margin-bottom: 14rpx; }
.hud-pill {
  display: flex; align-items: center; gap: 8rpx;
  background: var(--card); border: 4rpx solid var(--ink);
  border-radius: 99rpx; padding: 8rpx 20rpx;
  font-size: 24rpx; font-weight: 700;
  box-shadow: 4rpx 4rpx 0 var(--ink);
}
.hud-pill.streak { background: var(--hi); }
.xp {
  height: 20rpx; border: 4rpx solid var(--ink); border-radius: 99rpx;
  background: var(--paper2); overflow: hidden; margin-bottom: 28rpx;
}
.xp-fill {
  height: 100%;
  background: repeating-linear-gradient(45deg, var(--hi) 0 12rpx, #F5D93F 12rpx 24rpx);
  transition: width .4s;
}

.main-card { text-align: center; padding: 40rpx 32rpx 48rpx; }
.status { display: flex; align-items: center; justify-content: center; gap: 10rpx; font-size: 24rpx; color: var(--ink-soft); letter-spacing: 4rpx; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--ink-soft); }
.dot.live { background: var(--coral); animation: blink 1s infinite; }
.dot.paused { background: var(--hi); border: 2rpx solid var(--ink); }
@keyframes blink { 50% { opacity: .25; } }
.clock { font-size: 100rpx; font-weight: 700; margin-top: 12rpx; letter-spacing: 2rpx; }
.money {
  display: inline-block; font-size: 64rpx; font-weight: 700; margin-top: 8rpx; padding: 0 12rpx;
  background: linear-gradient(transparent 55%, var(--hi) 55% 95%, transparent 95%);
}
.eq { margin-top: 8rpx; font-size: 24rpx; color: var(--ink-soft); }
.fish { position: absolute; right: 28rpx; bottom: 16rpx; font-size: 56rpx; transform: rotate(-18deg); opacity: .9; }

.types { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin: 28rpx 0; }
.type-card {
  position: relative; display: flex; flex-direction: column; align-items: center; gap: 6rpx;
  padding: 28rpx 0 24rpx; background: var(--card);
  border: 4rpx solid var(--ink);
  border-radius: 24rpx 40rpx 20rpx 36rpx / 36rpx 20rpx 40rpx 24rpx;
  box-shadow: 6rpx 6rpx 0 var(--ink);
}
.type-card:active { transform: translate(4rpx, 4rpx); box-shadow: none; }
.type-card.on { background: var(--hi); }
.type-card.lock { opacity: .55; }
.t-icon { font-size: 56rpx; }
.t-name { font-size: 28rpx; font-weight: 700; }
.t-coef {
  position: absolute; top: -14rpx; right: -8rpx;
  background: var(--sea); border: 3rpx solid var(--ink); border-radius: 99rpx;
  font-size: 20rpx; font-weight: 700; padding: 2rpx 12rpx; transform: rotate(6deg);
}

.m-money { font-size: 72rpx; font-weight: 700; margin-top: 16rpx;
  background: linear-gradient(transparent 55%, var(--hi) 55% 95%, transparent 95%); display: inline-block; padding: 0 12rpx; }
.m-dur { margin-top: 6rpx; color: var(--ink-soft); font-size: 26rpx; }
.m-quip { margin-top: 14rpx; font-size: 28rpx; }
