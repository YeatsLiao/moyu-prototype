.page { padding: 24rpx 28rpx 40rpx; }

.report { text-align: center; padding: 52rpx 36rpx 44rpx; }
.stamp {
  position: absolute; top: 28rpx; right: 24rpx;
  width: 96rpx; height: 96rpx; border: 4rpx solid var(--coral); border-radius: 50%;
  color: var(--coral); font-size: 22rpx; font-weight: 700; line-height: 1.3;
  display: flex; align-items: center; justify-content: center; text-align: center;
  transform: rotate(16deg); opacity: .85;
}
.rc-brand { font-size: 26rpx; font-weight: 700; letter-spacing: 8rpx; }
.rc-date { font-size: 22rpx; color: var(--ink-soft); margin-top: 6rpx; }
.rc-money { font-size: 108rpx; font-weight: 700; margin-top: 16rpx; display: inline-block; padding: 0 12rpx;
  background: linear-gradient(transparent 55%, var(--hi) 55% 95%, transparent 95%); }
.rc-y { font-size: 48rpx; }
.rc-dur { margin-top: 8rpx; font-size: 26rpx; color: var(--ink-soft); }
.rc-eq { margin-top: 6rpx; font-size: 24rpx; color: #4A90B8; }
.price-entry {
  margin: 14rpx auto 0; display: inline-block;
  border: 3rpx dashed var(--ink); background: var(--paper2); border-radius: 99rpx;
  padding: 4rpx 24rpx; font-size: 22rpx; font-weight: 700;
}
.rc-divider { border-top: 3rpx dashed var(--ink); margin: 28rpx 20rpx 0; }
.rc-quip { margin-top: 22rpx; font-size: 30rpx; line-height: 1.6; }
.rc-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 28rpx; }
.rc-level {
  margin: 0 auto; border: 3rpx solid var(--ink); border-radius: 99rpx;
  padding: 6rpx 28rpx; font-size: 26rpx; font-weight: 700;
}
.rc-fish { position: absolute; right: 36rpx; bottom: 28rpx; font-size: 48rpx; transform: rotate(-14deg); }

.save-btn { margin-top: 20rpx; }
.offscreen { position: fixed; left: -9999rpx; top: 0; width: 375px; height: 560px; }

.price-list { display: flex; flex-direction: column; gap: 12rpx; margin-top: 20rpx; }
.price-row {
  display: flex; align-items: center; gap: 12rpx; padding: 16rpx;
  border: 3rpx solid var(--ink); border-radius: 20rpx 34rpx 16rpx 30rpx / 30rpx 16rpx 34rpx 20rpx;
  background: var(--card);
}
.p-name { font-size: 28rpx; font-weight: 700; white-space: nowrap; }
.p-name small { font-size: 20rpx; font-weight: 400; color: var(--ink-soft); }
.p-min { margin-left: auto; font-size: 22rpx; color: var(--ink-soft); white-space: nowrap; }
.p-price { font-size: 28rpx; font-weight: 700; min-width: 88rpx; text-align: right;
  background: linear-gradient(transparent 55%, var(--hi) 55% 95%, transparent 95%); padding: 0 4rpx; }
.price-note { margin-top: 16rpx; font-size: 22rpx; color: var(--ink-soft); text-align: center; }
